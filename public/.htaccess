# SPA fallback: все маршруты отдают index.html, а реальные файлы/папки/api — без изменений
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Если запрос — реальный файл или папка, отдаём как есть
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Не трогаем API-обработчики
  RewriteRule ^api/ - [L]

  # XML-фид товаров лендингов: если PHP-обработчик залит — отдаём через него,
  # иначе перенаправляем на облачную функцию с тем же содержимым
  RewriteCond %{DOCUMENT_ROOT}/api/feed.php -f
  RewriteRule ^feed\.xml$ /api/feed.php [L,QSA]
  RewriteRule ^feed\.xml$ https://functions.poehali.dev/9684a3e5-bba2-413b-9b77-f0bc4b2a7db2 [R=302,L,QSA]

  # Старый адрес раздела обандероливания — постоянный редирект на новый
  RewriteRule ^obanderolivayushchie-mashiny/?$ /obanderolivanie [R=301,L]

  # Боты мессенджеров и соцсетей не выполняют JS — отдаём им готовую
  # разметку превью с заголовком, описанием и картинкой нужной страницы
  RewriteCond %{HTTP_USER_AGENT} (TelegramBot|WhatsApp|vkShare|Viber|Discordbot|Slackbot|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|SkypeUriPreview|Iframely|redditbot|Pinterest|Google-InspectionTool|Yandexbot|YandexRenderResourcesBot) [NC]
  RewriteRule ^ /api/og.php [L]

  # Всё остальное — на index.html (роутинг React Router на клиенте)
  RewriteRule . /index.html [L]
</IfModule>

# Корректные MIME-типы для современных скриптов
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
</IfModule>

# Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Длинный кэш для статики с хешами в имени, короткий — для html
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>